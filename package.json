  "version": "0.1.0",
  "description": "A Gen 3–6 Pokémon companion: types, matchups, evolutions, moves and a stat calculator, powered by PokéAPI.",
  "license": "MIT",
  "author": "Johann Lochbaum",
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "scripts": {
